{
  "providers": {
    "YOUR_PROVIDER_NAME": {
      "baseUrl": "https://YOUR_ENDPOINT_HOST/v1",
      "api": "openai-completions",
      "apiKey": "${YOUR_API_KEY_ENV_VAR}",
      "models": [
        {
          "id": "YOUR_MODEL_ID",
          "reasoning": false,
          "input": ["text", "image"],
          "contextWindow": 128000,
          "maxTokens": 4096,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
